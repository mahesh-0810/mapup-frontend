# Base URL of the Go backend API.
# Local dev (default if unset): http://localhost:8080
NEXT_PUBLIC_API_URL=http://localhost:8080

# WebSocket URL for real-time alerts.
# Defaults to NEXT_PUBLIC_API_URL with http(s) swapped for ws(s) + /ws, so this
# is only needed if the WebSocket is served from a different URL than the API.
# NEXT_PUBLIC_WS_URL=ws://localhost:8080/ws
